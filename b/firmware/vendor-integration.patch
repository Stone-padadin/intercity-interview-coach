diff --git a/apps/main/agent/agent_app.c b/apps/main/agent/agent_app.c
--- a/apps/main/agent/agent_app.c
+++ b/apps/main/agent/agent_app.c
@@ -1,4 +1,7 @@
 #include "agent_app.h"
+#if CONFIG_B_DEVICE_SUPPORT
+#include "b_device_runtime.h"
+#endif
 #include "ljyd_cloud.h"
 #include "qm_config.h"
 
@@ -443,10 +446,16 @@
     (void)userdata;
     (void)iot_handle;
     if (event == LJYD_CLOUD_EVENT_CONNECTED) {
+#if CONFIG_B_DEVICE_SUPPORT
+        b_device_runtime_cloud(true);
+#endif
         agent_on_cloud_connected();
         return;
     }
     if (event == LJYD_CLOUD_EVENT_DISCONNECTED) {
+#if CONFIG_B_DEVICE_SUPPORT
+        b_device_runtime_cloud(false);
+#endif
         agent_on_cloud_disconnected();
     }
 }
