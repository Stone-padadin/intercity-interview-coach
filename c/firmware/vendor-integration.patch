 #include "esp_cam_ctlr_spi.h"
 #include "esp_cam_sensor_xclk.h"
@@ -205,6 +215,31 @@ static esp_err_t cam_stream_on(void)
     return ESP_OK;
 }
 
+#if CONFIG_C_CAMERA_STANDALONE && !CONFIG_C_USB_PREVIEW
+/* Diagnostic profile only: one slow UART transfer, never in the live voice profile. */
+static void cam_dump_snapshot(const uint8_t *frame,size_t length)
+{
+    static const char hex[]="0123456789abcdef";
+    printf("\nCFRAME_BEGIN width=%" PRIu32 " height=%" PRIu32
+           " format=UYVY bytes=%u\n",s_cam.width,s_cam.height,(unsigned)length);
+    for (size_t offset=0,seq=0;offset<length;offset+=64,seq++) {
+        size_t count=length-offset;
+        if (count>64) { count=64; }
+        char payload[129];
+        for (size_t i=0;i<count;i++) {
+            payload[i*2]=hex[frame[offset+i]>>4];
+            payload[i*2+1]=hex[frame[offset+i]&15];
+        }
+        payload[count*2]='\0';
+        printf("CFRAME_DATA seq=%u %s\n",(unsigned)seq,payload);
+        /* UART output can busy-wait. Let IDLE1 run during the long diagnostic dump. */
+        if ((seq&15u)==15u) { vTaskDelay(pdMS_TO_TICKS(10)); }
+    }
+    printf("CFRAME_END crc32=%08" PRIx32 "\n",esp_rom_crc32_le(0,frame,length));
+    fflush(stdout);
+}
+#endif
+
 static void cam_stream_task(void *arg)
 {
     uint32_t frames = 0;
@@ -233,8 +268,28 @@ static void cam_stream_task(void *arg)
         }
 
         frames++;
-        if (buf.bytesused == expect) {
+        if (buf.index < CAM_BUF_NUM && buf.bytesused == expect &&
+            buf.bytesused <= s_cam.buffer_len[buf.index]) {
             good++;
+#if CONFIG_C_USB_PREVIEW
+            if (s_cam.pixel_format==V4L2_PIX_FMT_UYVY) {
+                c_usb_preview_frame(s_cam.buffer[buf.index],buf.bytesused,s_cam.width,s_cam.height,frames);
+            }
+#endif
+#if CONFIG_C_CAMERA_STANDALONE && !CONFIG_C_USB_PREVIEW
+            if (good==15 && s_cam.pixel_format==V4L2_PIX_FMT_UYVY) {
+                cam_dump_snapshot(s_cam.buffer[buf.index],buf.bytesused);
+            }
+#endif
+#if CONFIG_C_LIVE_POSE_SUPPORT
+            if (s_cam.pixel_format == V4L2_PIX_FMT_UYVY) {
+                (void)c_live_pose_submit(s_cam.buffer[buf.index],buf.bytesused,
+                                        s_cam.width,s_cam.height,frames);
+            } else if (good == 1) {
+                ESP_LOGE(LOG_TAG,"live pose needs UYVY; fourcc=0x%08" PRIx32,
+                         s_cam.pixel_format);
+            }
+#endif
         } else {
             empty++;
         }
